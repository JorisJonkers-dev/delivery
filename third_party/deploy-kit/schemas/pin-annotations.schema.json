            "estate.jorisjonkers.dev/rollback-version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "estate.jorisjonkers.dev/rollback-fragment": {
              "type": "string",
              "pattern": "^(?:[^@\\s/]+\\/)+[^@\\s/:]+@sha256:[a-f0-9]{64}$"
