{
  "schema": "cluster-state-snapshot.schema.json",
  "cases": [
    {
      "name": "the worked estate's empty snapshot",
      "verdict": "accept",
      "file": "examples/platform/cluster-state.yml"
    },
    {
      "name": "a snapshot recording an engine Process's active Instance mid-Move",
      "verdict": "accept",
      "file": "examples/platform/cluster-state.yml",
      "patch": [
        {
          "op": "add",
          "path": "/instances",
          "value": [
            {
              "application": "platform-postgres",
              "instance": "postgres",
              "version": "17.2.0",
              "namespace": "data-system",
              "node": "enschede-t1000-1",
              "phase": "retire",
              "flippedAt": "2026-10-26T12:00:00Z"
            }
          ]
        }
      ]
    },
    {
      "name": "an active Instance at a phase that is no step of a Move",
      "verdict": "refuse",
      "breaks": "enum",
      "file": "examples/platform/cluster-state.yml",
      "patch": [
        {
          "op": "add",
          "path": "/instances",
          "value": [
            {
              "application": "platform-postgres",
              "instance": "postgres",
              "version": "17.2.0",
              "namespace": "data-system",
              "node": "enschede-t1000-1",
              "phase": "halfway"
            }
          ]
        }
      ]
    },
    {
      "name": "an active Instance whose version is not major.minor.patch",
      "verdict": "refuse",
      "breaks": "rule",
      "file": "examples/platform/cluster-state.yml",
      "patch": [
        {
          "op": "add",
          "path": "/instances",
          "value": [
            {
              "application": "platform-postgres",
              "instance": "postgres",
              "version": "17",
              "namespace": "data-system",
              "node": "enschede-t1000-1"
            }
          ]
        }
      ]
    },
    {
      "name": "a field the model does not have",
      "verdict": "refuse",
      "breaks": "unknown-field",
      "file": "examples/platform/cluster-state.yml",
      "patch": [
        {
          "op": "add",
          "path": "/colour",
          "value": "blue"
        }
      ]
    },
    {
      "name": "a snapshot of no cluster",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/platform/cluster-state.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/cluster"
        }
      ]
    },
    {
      "name": "bindings written as a word",
      "verdict": "refuse",
      "breaks": "wrong-type",
      "file": "examples/platform/cluster-state.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/bindings",
          "value": "none"
        }
      ]
    },
    {
      "name": "a document of another kind",
      "verdict": "refuse",
      "breaks": "enum",
      "file": "examples/platform/cluster-state.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/kind",
          "value": "Cluster"
        }
      ]
    }
  ]
}
