# The Process scope: what the Release Gate's one Process receives (deploy-kit spec/v1, chapter 10,
# Configuration). Literals are literal.

# --- who may scrape GET /metrics (cmd/release-gate): the metrics stack's Prometheus pods. The
# observability Project is still on the old path, where no render names it, so it is named here.
METRICS_SCRAPER_NAMESPACE=observability
METRICS_SCRAPER_SELECTOR=app.kubernetes.io/name=prometheus,prometheus=metrics-stack-prometheus
METRICS_SCRAPER_SERVICE_ACCOUNT=metrics-stack-prometheus
