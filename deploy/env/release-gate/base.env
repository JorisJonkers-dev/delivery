# The Process scope: what the Release Gate's one Process receives (deploy-kit spec/v1, chapter 10,
# Configuration). Literals are literal.

# --- who may scrape GET /metrics (cmd/release-gate): the metrics stack's Prometheus pods, the
# observability Project's in observability-system since its handover (JorisJonkers-dev/deploy-kit#660).
METRICS_SCRAPER_NAMESPACE=observability-system
METRICS_SCRAPER_SELECTOR=app.kubernetes.io/name=prometheus,prometheus=prometheus
METRICS_SCRAPER_SERVICE_ACCOUNT=prometheus
