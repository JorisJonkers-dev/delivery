# The Process scope: what the Collector's one Process receives (deploy-kit spec/v1, chapter 10,
# Configuration). Literals are literal; a secret is a named placeholder over a grant it holds.

# --- what it captures, and where it commits it (cmd/collector)
CLUSTER_NAME=production
ESTATE_REPOSITORY=JorisJonkers-dev/estate

# --- its GitHub App, installed on the Estate repository alone
GITHUB_APP_ID=${secret:secret/data/delivery-system/collector#app-id}
GITHUB_APP_INSTALLATION_ID=${secret:secret/data/delivery-system/collector#installation-id}
GITHUB_APP_PRIVATE_KEY=${secret:secret/data/delivery-system/collector#private-key}
