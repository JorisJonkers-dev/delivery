# The Process scope: what the Reporter's one Process receives (deploy-kit spec/v1, chapter 10,
# Configuration). Literals are literal; a secret is a named placeholder over a grant it holds.

# --- where the units are (cmd/reporter)
FLUX_NAMESPACE=flux-system

# --- its GitHub App, installed on every repository that releases to the estate
GITHUB_APP_ID=${secret:secret/data/delivery-system/reporter#app-id}
GITHUB_APP_INSTALLATION_ID=${secret:secret/data/delivery-system/reporter#installation-id}
GITHUB_APP_PRIVATE_KEY=${secret:secret/data/delivery-system/reporter#private-key}
